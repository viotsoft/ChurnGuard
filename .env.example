# Local development
RAILS_ENV=development
APP_HOST=localhost:3000
HOST=localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=

# Sidekiq / Redis
REDIS_URL=redis://localhost:6379/0

# Shopify app credentials
# Development boot requires these because shopify_app validates them when Rails::Server starts.
SHOPIFY_API_KEY=replace_me
SHOPIFY_API_SECRET=replace_me

# Transactional email
POSTMARK_API_TOKEN=
APP_MAILER_FROM=ChurnGuard <hello@churnguard.local>

# Error reporting
SENTRY_DSN=

# Data Lab
PYTHON_BIN=python3
DATA_LAB_HASH_SECRET=replace-with-a-long-random-secret
MAIL_FROM=ChurnGuard <noreply@example.com>
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
