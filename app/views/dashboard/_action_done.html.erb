<%#
  Turbo Stream replacement partial for a card after approve/skip.
  Shows a compact "done" row instead of the full card.
  Locals: action (Action), outcome (:approved | :skipped)
%>
<% customer = action.customer %>
<% currency  = customer.orders.first&.currency || "EUR" %>
<% symbol    = currency == "EUR" ? "€" : currency %>
<% revenue   = "#{symbol}#{action.revenue_at_risk.round(0).to_i}" %>

<div class="done-card" id="action_<%= action.id %>"
     style="animation: slideIn 300ms cubic-bezier(0.0,0.0,0.2,1);">
  <div class="done-card__left">
    <div class="done-card__icon">
      <%= outcome == :approved ? "✓" : "–" %>
    </div>
    <div>
      <div class="done-card__name"><%= customer.display_name %></div>
      <div class="done-card__sub">
        <%= outcome == :approved ? "Discount queued · sending via Klaviyo" : "Skipped" %>
      </div>
    </div>
  </div>
  <% if outcome == :approved %>
    <div class="done-card__revenue">Est. recovery <%= revenue %></div>
  <% end %>
</div>

<style>
  @keyframes slideIn {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
