<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? yield(:title) + " — ChurnGuard" : "ChurnGuard" %></title>
  <meta name="csrf-param" content="<%= request_forgery_protection_token %>">
  <meta name="csrf-token" content="<%= form_authenticity_token %>">

  <%# Fonts: Fraunces (display), Instrument Sans (UI), Geist Mono (data) %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Instrument+Sans:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">

  <%= javascript_importmap_tags %>

  <style>
    /* ── Design tokens (DESIGN.md) ──────────────────────────────────────────── */
    :root {
      --bg:            #F5F0E8;
      --surface:       #FDFAF4;
      --surface-2:     #F0EAE0;
      --text:          #1A1410;
      --text-muted:    #8A7E6F;
      --text-faint:    #B0A594;
      --accent:        #D4500A;
      --accent-hover:  #B8400A;
      --accent-light:  #FAE8DE;
      --success:       #3D7A5C;
      --success-light: #E0F0E8;
      --warning:       #C28A10;
      --warning-light: #FDF3D4;
      --danger:        #C9400E;
      --danger-light:  #FAEAE0;
      --border:        #DDD5C8;
      --border-soft:   #EBE4DB;
      --radius-sm:     4px;
      --radius-md:     8px;
      --radius-lg:     12px;
      --radius-xl:     16px;
      --radius-full:   9999px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Instrument Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;
      min-height: 100vh;
    }

    /* ── Queue layout (index — no sidebar) ─────────────────────────────────── */
    .queue-header {
      position: sticky; top: 0; z-index: 10;
      background: var(--bg);
      border-bottom: 1px solid var(--border-soft);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 24px; height: 56px;
    }

    .queue-header__logo {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 18px; font-weight: 700; color: var(--text);
      letter-spacing: -0.02em; text-decoration: none;
    }

    .queue-header__center {
      position: absolute; left: 50%; transform: translateX(-50%);
    }

    .pending-pill {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--accent-light);
      color: var(--accent);
      font-size: 13px; font-weight: 600;
      padding: 4px 12px; border-radius: var(--radius-full);
    }

    .pending-pill__dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--accent); flex-shrink: 0;
    }

    .queue-header__actions { display: flex; align-items: center; gap: 12px; }

    .icon-btn {
      width: 36px; height: 36px; border-radius: var(--radius-md);
      display: flex; align-items: center; justify-content: center;
      background: transparent; border: 1px solid var(--border);
      color: var(--text-muted); cursor: pointer; transition: all 100ms;
      text-decoration: none;
    }
    .icon-btn:hover { background: var(--surface-2); color: var(--text); }

    .queue-body {
      max-width: 560px; margin: 0 auto;
      padding: 32px 16px 64px;
    }

    /* ── Sidebar layout (history / insights / settings) ─────────────────────── */
    .app-shell {
      display: flex; min-height: 100vh;
    }

    .sidebar {
      width: 220px; flex-shrink: 0;
      background: var(--surface);
      border-right: 1px solid var(--border-soft);
      display: flex; flex-direction: column;
      padding: 24px 16px;
      position: sticky; top: 0; height: 100vh; overflow-y: auto;
    }

    .sidebar__logo {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 17px; font-weight: 700; color: var(--text);
      letter-spacing: -0.02em; text-decoration: none;
      margin-bottom: 32px; display: block;
    }

    .sidebar__nav { display: flex; flex-direction: column; gap: 4px; }

    .sidebar__link {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 12px; border-radius: var(--radius-md);
      font-size: 14px; font-weight: 500; color: var(--text-muted);
      text-decoration: none; transition: all 100ms;
    }
    .sidebar__link:hover { background: var(--surface-2); color: var(--text); }
    .sidebar__link--active { background: var(--surface-2); color: var(--text); font-weight: 600; }

    .main-content {
      flex: 1; max-width: 900px; padding: 40px 40px 64px;
    }

    .page-title {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 28px; font-weight: 600; color: var(--text);
      letter-spacing: -0.02em; margin-bottom: 24px;
    }

    /* ── Flash messages ─────────────────────────────────────────────────────── */
    .flash {
      padding: 12px 16px; border-radius: var(--radius-md);
      font-size: 14px; font-weight: 500; margin-bottom: 20px;
    }
    .flash--notice { background: var(--success-light); color: var(--success); }
    .flash--alert  { background: var(--danger-light);  color: var(--danger);  }

    /* ── Metrics bar ─────────────────────────────────────────────────────────── */
    .metrics-bar {
      display: flex; gap: 16px; margin-bottom: 32px;
      flex-wrap: wrap;
    }

    .metric-chip {
      background: var(--surface);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius-lg);
      padding: 14px 20px;
      flex: 1; min-width: 120px;
    }

    .metric-chip__label {
      font-size: 11px; font-weight: 600; color: var(--text-faint);
      letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px;
    }

    .metric-chip__value {
      font-family: 'Geist Mono', 'JetBrains Mono', monospace;
      font-size: 22px; font-weight: 500; color: var(--text);
      font-variant-numeric: tabular-nums;
    }

    .metric-chip__value--accent { color: var(--accent); }

    /* ── Approval card ───────────────────────────────────────────────────────── */
    .card-wrap {
      perspective: 1200px;
      margin-bottom: 20px;
    }

    .action-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 28px;
      transition: transform 300ms cubic-bezier(0.4, 0.0, 0.2, 1),
                  opacity 300ms cubic-bezier(0.4, 0.0, 0.2, 1);
      transform-style: preserve-3d;
      position: relative;
    }

    /* Card header: customer name (top-left) + revenue (top-right) */
    .card-header {
      display: flex; align-items: flex-start;
      justify-content: space-between; gap: 16px;
      margin-bottom: 16px;
    }

    .customer-name {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 28px; font-weight: 600; color: var(--text);
      letter-spacing: -0.02em; line-height: 1.15;
    }

    /* Revenue at risk — Geist Mono, terracotta, shown FIRST (top-right) */
    .revenue-at-risk {
      font-family: 'Geist Mono', 'JetBrains Mono', monospace;
      font-size: 20px; font-weight: 500; color: var(--accent);
      font-variant-numeric: tabular-nums;
      white-space: nowrap; text-align: right;
    }

    .revenue-at-risk__label {
      font-family: 'Instrument Sans', sans-serif;
      font-size: 10px; font-weight: 600; color: var(--text-faint);
      letter-spacing: 0.08em; text-transform: uppercase;
      display: block; margin-bottom: 2px;
    }

    /* Customer metadata row */
    .card-meta {
      display: flex; flex-wrap: wrap; gap: 12px;
      font-size: 13px; color: var(--text-muted);
      margin-bottom: 14px;
    }

    .card-meta__item { display: flex; align-items: center; gap: 4px; }

    /* Risk badge */
    .risk-badge {
      display: inline-flex; align-items: center; gap: 5px;
      font-size: 11px; font-weight: 600; letter-spacing: 0.06em;
      text-transform: uppercase; padding: 3px 9px;
      border-radius: var(--radius-sm);
    }

    .risk-badge__dot { width: 5px; height: 5px; border-radius: 50%; }

    .risk-badge--high   { background: var(--danger-light);  color: var(--danger);  }
    .risk-badge--high   .risk-badge__dot { background: var(--danger); }
    .risk-badge--medium { background: var(--warning-light); color: var(--warning); }
    .risk-badge--medium .risk-badge__dot { background: var(--warning); }
    .risk-badge--low    { background: var(--success-light); color: var(--success); }
    .risk-badge--low    .risk-badge__dot { background: var(--success); }

    /* Risk reason box */
    .risk-reason {
      background: var(--surface-2);
      border-left: 3px solid var(--accent-light);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
      padding: 10px 14px;
      font-size: 13px; font-style: italic; color: var(--text-muted);
      line-height: 1.5; margin: 14px 0 20px;
    }

    /* Card buttons */
    .card-actions { display: flex; flex-direction: column; gap: 10px; }

    .btn-primary {
      width: 100%; padding: 13px 20px;
      background: var(--accent); color: #fff;
      border: none; border-radius: var(--radius-md);
      font-family: 'Instrument Sans', sans-serif;
      font-size: 14px; font-weight: 600; cursor: pointer;
      transition: background 150ms;
      text-align: center; text-decoration: none;
      display: block;
    }
    .btn-primary:hover { background: var(--accent-hover); }

    .btn-ghost {
      width: 100%; padding: 11px 20px;
      background: transparent; color: var(--text-muted);
      border: 1px solid var(--border); border-radius: var(--radius-md);
      font-family: 'Instrument Sans', sans-serif;
      font-size: 14px; font-weight: 500; cursor: pointer;
      transition: all 150ms;
      text-align: center; text-decoration: none;
      display: block;
    }
    .btn-ghost:hover { background: var(--surface-2); color: var(--text); }

    /* ── Done card (post-approve/skip confirmation state) ────────────────────── */
    .done-card {
      background: var(--surface);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius-xl);
      padding: 20px 28px;
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 12px;
    }

    .done-card__left { display: flex; align-items: center; gap: 12px; }
    .done-card__icon { font-size: 20px; }
    .done-card__name {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 16px; font-weight: 600; color: var(--text);
    }
    .done-card__sub { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
    .done-card__revenue {
      font-family: 'Geist Mono', monospace;
      font-size: 14px; color: var(--success);
      font-variant-numeric: tabular-nums;
    }

    /* ── Empty state ─────────────────────────────────────────────────────────── */
    .empty-state {
      text-align: center; padding: 64px 24px;
    }
    .empty-state__icon { font-size: 48px; margin-bottom: 20px; display: block; }
    .empty-state__heading {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 24px; font-weight: 600; color: var(--text);
      letter-spacing: -0.02em; margin-bottom: 10px;
    }
    .empty-state__body { font-size: 15px; color: var(--text-muted); line-height: 1.6; max-width: 380px; margin: 0 auto; }

    /* ── Revenue impact calculator (empty state) ─────────────────────────────── */
    .impact-calc {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      padding: 28px; margin-top: 32px; text-align: left;
    }
    .impact-calc__eyebrow {
      font-size: 11px; font-weight: 600; color: var(--text-faint);
      letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 8px;
    }
    .impact-calc__headline {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 20px; font-weight: 600; color: var(--text);
      letter-spacing: -0.01em; margin-bottom: 8px;
    }
    .impact-calc__body { font-size: 14px; color: var(--text-muted); line-height: 1.6; }

    /* ── History table ───────────────────────────────────────────────────────── */
    .history-table {
      width: 100%; border-collapse: collapse;
      font-size: 14px;
    }
    .history-table th {
      text-align: left; padding: 0 16px 10px;
      font-size: 11px; font-weight: 600; color: var(--text-faint);
      letter-spacing: 0.08em; text-transform: uppercase;
      border-bottom: 1px solid var(--border-soft);
    }
    .history-table td {
      padding: 14px 16px;
      border-bottom: 1px solid var(--border-soft);
      vertical-align: middle;
    }
    .history-table tr:last-child td { border-bottom: none; }

    .status-pill {
      display: inline-flex; align-items: center; gap: 5px;
      font-size: 11px; font-weight: 600; padding: 3px 9px;
      border-radius: var(--radius-sm); text-transform: uppercase; letter-spacing: 0.05em;
    }
    .status-pill--executed { background: var(--success-light); color: var(--success); }
    .status-pill--skipped  { background: var(--surface-2);     color: var(--text-muted); }
    .status-pill--expired  { background: var(--surface-2);     color: var(--text-faint); }
    .status-pill--failed   { background: var(--danger-light);  color: var(--danger); }
    .status-pill--approved { background: var(--accent-light);  color: var(--accent); }

    /* ── Settings form ───────────────────────────────────────────────────────── */
    .settings-section {
      background: var(--surface);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius-xl);
      padding: 28px; margin-bottom: 20px;
    }
    .settings-section__title {
      font-size: 15px; font-weight: 600; color: var(--text);
      margin-bottom: 4px;
    }
    .settings-section__sub { font-size: 13px; color: var(--text-muted); margin-bottom: 20px; }

    .form-field { margin-bottom: 16px; }
    .form-field label {
      display: block; font-size: 13px; font-weight: 600;
      color: var(--text); margin-bottom: 6px;
    }
    .form-field input[type="text"],
    .form-field input[type="password"] {
      width: 100%; padding: 10px 14px;
      border: 1px solid var(--border); border-radius: var(--radius-md);
      background: var(--bg); color: var(--text);
      font-family: 'Geist Mono', monospace; font-size: 13px;
      transition: border-color 150ms;
    }
    .form-field input:focus {
      outline: none; border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-light);
    }

    .connection-badge {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 12px; font-weight: 600; padding: 4px 10px;
      border-radius: var(--radius-sm);
    }
    .connection-badge__dot { width: 6px; height: 6px; border-radius: 50%; }
    .connection-badge--connected    { background: var(--success-light); color: var(--success); }
    .connection-badge--connected    .connection-badge__dot { background: var(--success); }
    .connection-badge--disconnected { background: var(--danger-light);  color: var(--danger); }
    .connection-badge--disconnected .connection-badge__dot { background: var(--danger); }

    .demo-results-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 20px;
      margin: 28px 0;
    }

    @media (max-width: 640px) {
      .queue-body { padding: 16px 12px 48px; }
      .action-card { padding: 20px; }
      .customer-name { font-size: 22px; }
      .revenue-at-risk { font-size: 16px; }
      .sidebar { display: none; }
      .main-content { padding: 24px 16px 48px; }
      .demo-results-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<%# ── Queue layout: no sidebar (approval queue / home screen) ─────────────── %>
<% if content_for?(:queue_layout) %>
  <header class="queue-header">
    <%= link_to "ChurnGuard", dashboard_index_path, class: "queue-header__logo" %>
    <div class="queue-header__center">
      <span id="pending-pill">
        <% if @pending_count.to_i > 0 %>
          <span class="pending-pill">
            <span class="pending-pill__dot"></span>
            <%= @pending_count %> pending
          </span>
        <% end %>
      </span>
    </div>
    <div class="queue-header__actions">
      <%= link_to demo_results_dashboard_index_path, class: "icon-btn", title: "Demo results" do %>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 12V8M8 12V4M13 12V6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      <% end %>
      <%= link_to history_dashboard_index_path, class: "icon-btn", title: "History" do %>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 4h12M2 8h8M2 12h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      <% end %>
      <%= link_to settings_path, class: "icon-btn", title: "Settings" do %>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="8" cy="8" r="2.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.42 1.42M11.53 11.53l1.42 1.42M11.53 4.47l1.42-1.42M3.05 12.95l1.42-1.42" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      <% end %>
    </div>
  </header>

  <% flash.each do |type, message| %>
    <div style="max-width:560px;margin:12px auto 0;padding:0 16px;">
      <div class="flash flash--<%= type %>"><%= message %></div>
    </div>
  <% end %>

  <main class="queue-body">
    <%= yield %>
  </main>

<%# ── Sidebar layout: history / insights / settings ──────────────────────── %>
<% else %>
  <div class="app-shell">
    <nav class="sidebar">
      <%= link_to "ChurnGuard", dashboard_index_path, class: "sidebar__logo" %>
      <div class="sidebar__nav">
        <%= link_to "↑ Approval queue", dashboard_index_path,
              class: "sidebar__link #{controller_name == 'dashboard' && action_name == 'index' ? 'sidebar__link--active' : ''}" %>
        <%= link_to "Demo results", demo_results_dashboard_index_path,
              class: "sidebar__link #{controller_name == 'dashboard' && action_name == 'demo_results' ? 'sidebar__link--active' : ''}" %>
        <%= link_to "History", history_dashboard_index_path,
              class: "sidebar__link #{controller_name == 'dashboard' && action_name == 'history' ? 'sidebar__link--active' : ''}" %>
        <%= link_to "Insights", insights_dashboard_index_path,
              class: "sidebar__link #{controller_name == 'dashboard' && action_name == 'insights' ? 'sidebar__link--active' : ''}" %>
        <div style="height:1px;background:var(--border-soft);margin:12px 0;"></div>
        <%= link_to "Data Lab", lab_root_path, class: "sidebar__link" %>
        <%= link_to "Settings", settings_path,
              class: "sidebar__link #{controller_name == 'settings' ? 'sidebar__link--active' : ''}" %>
      </div>
    </nav>

    <main class="main-content">
      <% flash.each do |type, message| %>
        <div class="flash flash--<%= type %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
  </div>
<% end %>

</body>
</html>
