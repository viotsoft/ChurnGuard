<style>
  .skipped-icon { font-size: 36px; margin-bottom: 16px; display: block; }
  .skipped-heading {
    font-family: 'Fraunces', Georgia, 'Times New Roman', serif;
    font-size: 28px; font-weight: 600; color: #1A1410;
    letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 12px;
  }
  .skipped-sub {
    font-size: 15px; color: #8A7E6F; line-height: 1.6; margin-bottom: 24px;
  }
  .reassurance-box {
    background: #F0EAE0; border-left: 3px solid #DDD5C8;
    border-radius: 0 8px 8px 0; padding: 14px 18px; margin-bottom: 28px;
  }
  .reassurance-box p {
    font-size: 14px; color: #6B5C4A; line-height: 1.55; font-style: italic;
  }
  .divider { border: none; border-top: 1px solid #EBE4DB; margin: 24px 0; }
  .dashboard-link {
    display: block; text-align: center;
    font-size: 14px; font-weight: 600; color: #8A7E6F;
    text-decoration: none; padding: 10px;
    border: 1px solid #DDD5C8; border-radius: 8px;
  }
  .dashboard-link:hover { color: #1A1410; border-color: #B0A594; }
</style>

<span class="skipped-icon">○</span>

<h1 class="skipped-heading">Skipped for now</h1>

<p class="skipped-sub">
  No action was taken for <strong><%= @customer.display_name %></strong>.
  That's completely fine.
</p>

<div class="reassurance-box">
  <p>
    If <%= @customer.display_name.split.first %> is still at risk tomorrow,
    you'll hear from us again in your next daily summary. You're always in control.
  </p>
</div>

<hr class="divider">

<a href="<%= root_path %>" class="dashboard-link">
  View dashboard →
</a>
